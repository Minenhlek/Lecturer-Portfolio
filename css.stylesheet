/* ========== RESET & VARIABLES ========== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --bg: #000000;
    --surface: #0a0a0a;
    --card: #111111;
    --border: #1e1e1e;
    --blue: #1E90FF;
    --blue2: #5ab4ff;
    --blue3: rgba(30,144,255,.12);
    --text: #f0f0f0;
    --muted: #888;
    --grad: linear-gradient(135deg, #1E90FF, #5ab4ff);
}

html {
    scroll-behavior: smooth;
}

body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Segoe UI', system-ui, sans-serif;
    overflow-x: hidden;
}

a {
    text-decoration: none;
    color: inherit;
}

::-webkit-scrollbar {
    width: 5px;
}

::-webkit-scrollbar-track {
    background: #000;
}

::-webkit-scrollbar-thumb {
    background: var(--blue);
    border-radius: 3px;
}

/* ========== NAVIGATION ========== */
nav {
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 999;
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: .3s;
}

    nav.scrolled {
        background: rgba(0,0,0,.92);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
    }

.logo {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--blue);
}

.nav-links {
    display: flex;
    gap: 2rem;
    list-style: none;
}

    .nav-links a {
        color: var(--muted);
        font-size: .88rem;
        transition: .3s;
        letter-spacing: .5px;
    }

        .nav-links a:hover {
            color: var(--blue);
        }

.hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    z-index: 1001;
}

    .hamburger span {
        width: 24px;
        height: 2px;
        background: var(--text);
        transition: .3s;
        display: block;
    }

    .hamburger.open span:nth-child(1) {
        transform: translateY(7px) rotate(45deg);
    }

    .hamburger.open span:nth-child(2) {
        opacity: 0;
    }

    .hamburger.open span:nth-child(3) {
        transform: translateY(-7px) rotate(-45deg);
    }

/* ========== HERO SECTION ========== */
#home {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem;
    position: relative;
    overflow: hidden;
}

.grid-bg {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(30,144,255,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(30,144,255,.04) 1px, transparent 1px);
    background-size: 50px 50px;
    animation: gridPulse 4s ease-in-out infinite;
}

@keyframes gridPulse {
    0%, 100% {
        opacity: .5;
    }

    50% {
        opacity: 1;
    }
}

.glow {
    position: absolute;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(30,144,255,.15) 0%, transparent 70%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: glowPulse 3s ease-in-out infinite;
}

@keyframes glowPulse {
    0%, 100% {
        transform: translate(-50%, -50%) scale(1);
    }

    50% {
        transform: translate(-50%, -50%) scale(1.2);
    }
}

.hero-content {
    position: relative;
    z-index: 2;
}

.avatar-container {
    width: 160px;
    height: 160px;
    margin: 0 auto 2rem;
    position: relative;
}

.avatar-ring {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    border: 2px solid transparent;
    background: var(--grad) border-box;
    -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
    mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: destination-out;
    mask-composite: exclude;
    animation: spin 8s linear infinite;
}

.avatar-ring2 {
    position: absolute;
    inset: -20px;
    border-radius: 50%;
    border: 1px solid rgba(30,144,255,.2);
    animation: spin 12s linear infinite reverse;
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}

.avatar {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    background: linear-gradient(135deg, #0a1628, #0d2040);
    border: 2px solid rgba(30,144,255,.3);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.hero-badge {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    background: rgba(30,144,255,.1);
    border: 1px solid rgba(30,144,255,.3);
    color: var(--blue2);
    padding: .35rem 1rem;
    border-radius: 50px;
    font-size: .78rem;
    margin-bottom: 1rem;
    animation: fadeUp .8s ease both;
}

h1.name {
    font-size: clamp(2.2rem, 6vw, 4rem);
    font-weight: 900;
    margin-bottom: .4rem;
    animation: fadeUp .8s .15s ease both;
    letter-spacing: -1px;
}

.name span {
    background: var(--grad);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.hero-role {
    color: var(--blue2);
    font-size: clamp(.95rem, 2vw, 1.2rem);
    margin-bottom: 1.5rem;
    animation: fadeUp .8s .3s ease both;
}

.hero-desc {
    color: var(--muted);
    max-width: 540px;
    margin: 0 auto 2.5rem;
    line-height: 1.8;
    animation: fadeUp .8s .45s ease both;
    font-size: .95rem;
}

.hero-btns {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    animation: fadeUp .8s .6s ease both;
}

.btn {
    padding: .7rem 1.8rem;
    border-radius: 6px;
    font-size: .9rem;
    font-weight: 600;
    transition: .3s;
    cursor: pointer;
    border: none;
    display: inline-flex;
    align-items: center;
    gap: .5rem;
}

.btn-primary {
    background: var(--blue);
    color: #000;
}

    .btn-primary:hover {
        background: var(--blue2);
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(30,144,255,.4);
    }

.btn-ghost {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--border);
}

    .btn-ghost:hover {
        border-color: var(--blue);
        color: var(--blue);
        transform: translateY(-2px);
    }

.scroll-down {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    color: var(--muted);
    font-size: .75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .5rem;
    animation: bounce 2s infinite;
}

    .scroll-down i {
        color: var(--blue);
    }

@keyframes bounce {
    0%, 100% {
        transform: translateX(-50%) translateY(0);
    }

    50% {
        transform: translateX(-50%) translateY(8px);
    }
}

@keyframes fadeUp {
    from {
        opacity: 0;
        transform: translateY(25px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* ========== GENERAL SECTIONS ========== */
section {
    padding: 6rem 2rem;
}

.container {
    max-width: 1080px;
    margin: 0 auto;
}

.sec-label {
    color: var(--blue);
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: 4px;
    text-transform: uppercase;
    margin-bottom: .5rem;
    text-align: center;
}

.sec-title {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    font-weight: 800;
    text-align: center;
    margin-bottom: .6rem;
    letter-spacing: -0.5px;
}

.sec-line {
    width: 40px;
    height: 3px;
    background: var(--grad);
    margin: 0 auto 3.5rem;
    border-radius: 2px;
}

/* ========== ABOUT SECTION ========== */
#about {
    background: var(--surface);
}

.about-grid {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 3rem;
    align-items: start;
}

.about-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 2rem;
    text-align: center;
}

.about-avatar {
    font-size: 4rem;
    margin-bottom: 1rem;
}

.about-card h3 {
    font-size: 1.1rem;
    margin-bottom: .3rem;
}

.about-card p {
    color: var(--muted);
    font-size: .85rem;
    margin-bottom: 1.5rem;
}

.stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .8rem;
}

.stat-box {
    background: var(--blue3);
    border: 1px solid rgba(30,144,255,.2);
    border-radius: 10px;
    padding: .8rem;
    text-align: center;
}

    .stat-box strong {
        display: block;
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--blue);
    }

    .stat-box span {
        font-size: .72rem;
        color: var(--muted);
    }

.about-text p {
    color: var(--muted);
    line-height: 1.85;
    margin-bottom: 1rem;
    font-size: .93rem;
}

.tags {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    margin-top: .8rem;
}

.tag {
    background: var(--blue3);
    border: 1px solid rgba(30,144,255,.25);
    color: var(--blue2);
    padding: .3rem .85rem;
    border-radius: 4px;
    font-size: .78rem;
}

/* ========== EXPERTISE SECTION ========== */
.mod-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 1.2rem;
    margin-bottom: 2.5rem;
}

.mod-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
    transition: .3s;
    position: relative;
    overflow: hidden;
}

    .mod-card::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: var(--grad);
        transform: scaleX(0);
        transition: .3s;
    }

    .mod-card:hover {
        border-color: rgba(30,144,255,.4);
        transform: translateY(-4px);
    }

        .mod-card:hover::after {
            transform: scaleX(1);
        }

.mod-icon {
    font-size: 1.8rem;
    margin-bottom: .8rem;
}

.mod-card h3 {
    font-size: .95rem;
    font-weight: 700;
    margin-bottom: .4rem;
}

.mod-card p {
    color: var(--muted);
    font-size: .83rem;
    line-height: 1.6;
}

.skills-box {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2rem;
}

    .skills-box h3 {
        font-size: 1rem;
        margin-bottom: 1.5rem;
        color: var(--blue2);
    }

.skill {
    margin-bottom: 1.1rem;
}

.skill-top {
    display: flex;
    justify-content: space-between;
    font-size: .83rem;
    margin-bottom: .4rem;
}

    .skill-top span:last-child {
        color: var(--blue);
    }

.track {
    height: 6px;
    background: var(--border);
    border-radius: 3px;
    overflow: hidden;
}

.fill {
    height: 100%;
    background: var(--grad);
    border-radius: 3px;
    width: 0;
    transition: width 1.2s ease;
}

/* ========== ACHIEVEMENTS SECTION ========== */
#achievements {
    background: var(--surface);
}

.ach-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.2rem;
}

.ach-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    gap: 1rem;
    transition: .3s;
}

    .ach-card:hover {
        border-color: rgba(30,144,255,.35);
        transform: translateY(-3px);
    }

.ach-ico {
    width: 46px;
    height: 46px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    flex-shrink: 0;
}

.ico-gold {
    background: rgba(255,200,60,.1);
    color: #FFC83C;
}

.ico-blue {
    background: var(--blue3);
    color: var(--blue2);
}

.ico-red {
    background: rgba(255,80,80,.1);
    color: #ff6060;
}

.ach-card h3 {
    font-size: .9rem;
    font-weight: 700;
    margin-bottom: .3rem;
}

.ach-card p {
    color: var(--muted);
    font-size: .82rem;
    line-height: 1.5;
}

.ach-year {
    font-size: .72rem;
    color: var(--blue);
    margin-top: .4rem;
}

/* ========== ADVICE SECTION ========== */
.quotes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.2rem;
}

.q-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.8rem;
    position: relative;
    transition: .3s;
}

    .q-card:hover {
        border-color: rgba(30,144,255,.3);
        transform: translateY(-3px);
    }

.q-mark {
    font-size: 4rem;
    color: rgba(30,144,255,.1);
    position: absolute;
    top: .5rem;
    left: 1.2rem;
    font-family: Georgia, serif;
    line-height: 1;
}

.q-card p {
    color: var(--text);
    font-size: .9rem;
    line-height: 1.75;
    margin-bottom: .8rem;
    position: relative;
    z-index: 1;
    padding-top: .8rem;
}

.q-card .q-auth {
    color: var(--blue);
    font-size: .78rem;
    font-weight: 600;
}

/* ========== CONTACT SECTION ========== */
#contact {
    background: var(--surface);
}

.contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
}

.contact-info h3 {
    font-size: 1.3rem;
    margin-bottom: .8rem;
}

.contact-info p {
    color: var(--muted);
    line-height: 1.8;
    margin-bottom: 2rem;
    font-size: .9rem;
}

.c-item {
    display: flex;
    align-items: center;
    gap: .9rem;
    margin-bottom: 1rem;
}

.c-ico {
    width: 40px;
    height: 40px;
    background: var(--blue3);
    border: 1px solid rgba(30,144,255,.2);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--blue);
    flex-shrink: 0;
}

.c-item strong {
    display: block;
    font-size: .85rem;
    margin-bottom: .1rem;
}

.c-item span {
    color: var(--muted);
    font-size: .82rem;
}

.contact-form {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2rem;
}

.fg {
    margin-bottom: 1rem;
}

    .fg label {
        display: block;
        font-size: .8rem;
        color: var(--muted);
        margin-bottom: .4rem;
    }

    .fg input, .fg textarea {
        width: 100%;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: .75rem 1rem;
        color: var(--text);
        font-size: .88rem;
        font-family: inherit;
        outline: none;
        transition: .3s;
    }

        .fg input:focus, .fg textarea:focus {
            border-color: var(--blue);
            box-shadow: 0 0 0 3px rgba(30,144,255,.1);
        }

    .fg textarea {
        height: 110px;
        resize: vertical;
    }

.btn-full {
    width: 100%;
    justify-content: center;
}

/* ========== FOOTER ========== */
footer {
    text-align: center;
    padding: 2rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: .82rem;
}

    footer span {
        color: var(--blue);
    }

/* ========== REVEAL ANIMATION ========== */
.reveal {
    opacity: 0;
    transform: translateY(35px);
    transition: opacity .65s ease, transform .65s ease;
}

    .reveal.visible {
        opacity: 1;
        transform: translateY(0);
    }

/* ========== MOBILE RESPONSIVE ========== */
@media (max-width: 768px) {
    .hamburger {
        display: flex;
    }

    .nav-links {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.97);
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2.5rem;
        opacity: 0;
        pointer-events: none;
        transition: .4s;
    }

        .nav-links.open {
            opacity: 1;
            pointer-events: all;
        }

        .nav-links a {
            font-size: 1.2rem;
        }

    .about-grid, .contact-grid {
        grid-template-columns: 1fr;
    }
}
